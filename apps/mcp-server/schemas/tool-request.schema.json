{
  "$id": "https://intentlock.dev/schemas/0.1.0/tool-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Agent Id",
      "type": "string"
    },
    "arguments": {
      "additionalProperties": true,
      "title": "Arguments",
      "type": "object"
    },
    "contract_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Contract Id",
      "type": "string"
    },
    "contract_version": {
      "minimum": 1,
      "title": "Contract Version",
      "type": "integer"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "tool": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Tool",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "run_id",
    "contract_id",
    "contract_version",
    "tool",
    "arguments",
    "agent_id",
    "timestamp"
  ],
  "title": "ToolRequest",
  "type": "object",
  "x-schema-version": "0.1.0"
}
