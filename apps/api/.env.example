# Control-plane API configuration (no secrets in this file; set real values in your shell).
INTENTLOCK_INTERNAL_TOKEN=            # required for /internal/*; share with the execution plane
INTENTLOCK_STORE=memory               # memory (local fallback) | dynamodb
INTENTLOCK_TABLE=                     # DynamoDB table (when INTENTLOCK_STORE=dynamodb)
AWS_REGION=us-east-1                  # dynamodb / bedrock; defaults to us-east-1 when unset
AWS_PROFILE=intentlock                # local CLI profile (never put keys in this file)
INTENTLOCK_BEDROCK_MODEL_ID=          # enables /api/contracts/propose
INTENTLOCK_CORS_ORIGINS=http://localhost:5173
# --- local-dev agent launcher (optional; see docs/handoffs/person1-control-plane.md) ---
INTENTLOCK_API_URL=http://127.0.0.1:8787
INTENTLOCK_AGENT_LAUNCH_ARGV=         # JSON array, e.g. ["python3","-B","/abs/apps/mcp-server/launch_kiro.py","--repository","/abs/demo/repository","--run-id","{run_id}","--contract-id","{contract_id}","--contract-version","{contract_version}","--prompt={mission}"]
INTENTLOCK_AGENT_CWD=
INTENTLOCK_AGENT_ENV_PASSTHROUGH=     # extra env names to forward (AWS_* is never forwarded)
INTENTLOCK_AGENT_LOG_DIR=
INTENTLOCK_AGENT_STOP_GRACE_SECONDS=3
KIRO_CLI_BINARY=                      # absolute path if kiro-cli is not on PATH
